    "dotenv": "16.6.1",
    "express": "4.22.3",
    "express-rate-limit": "7.5.1",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "prisma": "6.19.0",
    "tsx": "4.20.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.23",
    "@types/jsonwebtoken": "9.0.10",
