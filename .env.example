# Tùy chọn. Docker Compose chạy được ngay mà không cần tạo .env.
WEB_PORT=3000
JWT_SECRET=neu-local-demo-secret-change-before-deploy-2026
DEMO_MODE=true
PAYMENT_PROVIDER=DEMO
# Để nhận tiền thật: đổi PAYMENT_PROVIDER=PAYOS, DEMO_MODE=false và điền
# thông tin của kênh thanh toán. PUBLIC_APP_URL phải là URL HTTPS công khai
# để payOS gọi được /api/payments/payos/webhook.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
PUBLIC_APP_URL=http://localhost:3000
